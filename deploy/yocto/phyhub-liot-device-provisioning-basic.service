# L-IoT Provisioning Service - basic mode
#
# No-token registration flow:
#   1. Waits for snapd to seed.
#   2. Collects device facts.
#   3. POSTs them to snapd's local API.
#   4. Observes snapd until registration completes, then exits.
#
# Use this for series provisioning where snapd-as-collector or a non-claim
# Appstore handles the binding to a tenant.
#
# Console handling - identical to the claiming-token unit (board-agnostic):
#   * ExecStartPre stops every templated getty instance via a glob, so we
#     do not need to know the actual TTY name (ttymxc0, ttyS0, ttyAMA0, ...).
#   * StandardOutput=journal+console mirrors output to /dev/console, which
#     the kernel routes to whichever TTY the active "console=" arg picked.
#   * Conflicts=getty.target keeps gettys at bay while we run.
#   * ExecStopPost re-activates getty.target on exit, so the regular login
#     prompt resumes once the OS-Serial banner has been printed.
#
# Install:
#   copy to /lib/systemd/system/
#   systemctl enable liot-provisioning-basic.service
#
# After registration completes the unit exits and getty.target is reactivated
# - login prompts return automatically.
#
# On every subsequent boot the binary's own self-check (GET /v2/model/serial,
# 5s timeout) sees the existing serial and exits silently with code 0, so
# the unit costs roughly one local HTTP round-trip per boot once registered.

[Unit]
Description=L-IoT Device Provisioning (basic)
Documentation=https://github.com/l-iot/liot-provisioning
After=network-online.target snapd.service
Wants=network-online.target snapd.service
Before=getty.target
Conflicts=getty.target

[Service]
Type=simple
# Take the console exclusively before we attach. Three layered actions:
#
#   1. systemctl stop  - graceful stop of any templated getty.
#   2. systemctl kill  - SIGKILL anything that survived (e.g. agetty stuck
#                        in a read on the TTY, or gettys started outside
#                        systemd's normal templated units).
#   3. printf "\033c"  - ESC c, the full terminal reset. Clears any banner
#                        residue still in the UART display buffer so our
#                        output starts on a blank screen.
#
# Each step is best-effort (leading dash + `|| true`) so the unit stays
# healthy on boards where the matched units do not exist.
ExecStartPre=-/bin/sh -c '\
  systemctl stop "serial-getty@*.service" "getty@*.service" "console-getty.service" 2>/dev/null || true; \
  systemctl kill --signal=SIGKILL "serial-getty@*.service" "getty@*.service" "console-getty.service" 2>/dev/null || true; \
  printf "\\033c" > /dev/console 2>/dev/null || true \
'

ExecStart=/usr/bin/liot-provisioning basic

# Re-activate the login prompts when we exit. Conflicts=getty.target stops
# getty.target while we run, but it does NOT auto-restart on exit - without
# this line the device sits with no console after registration completes.
# Starting getty.target re-pulls the right templated serial-getty@<tty>
# (generated by systemd-getty-generator from /proc/cmdline's console=).
# The leading dash is belt-and-suspenders; the call is idempotent if the
# target is already active.
ExecStopPost=-/bin/systemctl start getty.target

# stdin is intentionally not a TTY: the tool does not read user input.
# Output is mirrored to journal *and* /dev/console so the user sees the
# OS-Serial banner on whatever TTY the kernel is using.
StandardInput=null
StandardOutput=journal+console
StandardError=journal+console

# One-shot: do not restart after exit.
Restart=no
User=root

[Install]
WantedBy=multi-user.target
